                                &increment,
                            )),
                        );
                }
                let text1 = dom.borrow_mut().create_text("Clicked ");
                dom.borrow_mut().append(button0, text1);
                let count_text2 = dom.borrow_mut().create_text("");
                dom.borrow_mut().append(button0, count_text2);
                {
                    let dom = Rc::clone(dom);
                    Effect::new(move || {
                        let shown = &(count.get());
                        #[allow(
                            clippy::implicit_clone,
                            reason = "a text hole or expression attribute shows any Display value through to_string; the compiler cannot see when it is already a String"
                        )]
                        let value = shown.to_string();
                        dom.borrow_mut().set_text_if_changed(count_text2, &value);
                    });
                }
                let text3 = dom.borrow_mut().create_text(" times");
                dom.borrow_mut().append(button0, text3);
                (count, roots)
