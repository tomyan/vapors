    #[allow(
        clippy::too_many_lines,
        reason = "mount_before builds the whole template, so its length follows the template's size"
    )]
    #[allow(
        clippy::needless_pass_by_value,
        reason = "every component takes its props struct by value, empty or not, so parents mount them alike"
    )]
    pub fn mount_before<D: Dom + ?Sized + 'static>(
        dom: &Rc<RefCell<D>>,
        parent: NodeId,
        before: Option<NodeId>,
        props: CounterProps,
    ) -> Self
    where
        Rc<RefCell<D>>: DynDom,
    {
        let CounterProps {} = props;
        dom.borrow_mut().add_style(SCOPE, STYLE);
        dom.borrow_mut().declare_events(&Self::events());
        let owner = Owner::new();
        let (count, roots) = owner
            .with(|| {
                let count: Signal<i32> = Signal::named("count", 0);
                let increment = move || count.update(|n| *n += 1);
                let mut roots = Vec::new();
                let button0 = dom.borrow_mut().create_keyed_element(&KEY_BUTTON0);
                dom.borrow_mut().insert_before(parent, button0, before);
                roots.push(Root::Node(button0));
                {
                    #[allow(
                        clippy::clone_on_copy,
                        reason = "a closure gets a clone of each binding it captures; the compiler cannot see which are Copy"
                    )]
