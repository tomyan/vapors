<style>
/* viewport 400x700 */
/* The gui-bench order row's progress: one fill, `percentage * 1.2` px
   wide in a 120 px track, for every percentage 0..=100. */
body { margin: 0; }
.track { position: relative; width: 120px; height: 6px; border-radius: 3px; background-color: #e5e7eb; margin-bottom: 0; }
.fill { position: absolute; left: 0; top: 0; height: 6px; border-radius: 3px; background-color: #4f46e5; }
</style>

