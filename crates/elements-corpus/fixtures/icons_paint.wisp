<style>
/* viewport 640x400 */
/* paint */
/* touche's icons (docs/icons.md, slice 3), drawn by vapors and by
   Chromium: each of the ten svgs in touche's crates/web/index.html,
   paths copied as they are, in a 44 px button with the svg centred by
   margin: auto, as touche's top bar has them under 400 px. Three rows:
   dark strokes on a light button, light strokes on a dark one, and a
   translucent colour (alpha 0.5) where Clipboard's two subpaths and
   Tools' crossing lines overlap. Dictate is left out: its <rect rx> is
   outside the icon subset, refused by design; touche rewrites it as a
   path. Buttons are flex containers so margin: auto centres on both
   axes in both engines. */
body { margin: 0; padding: 16px; background-color: #ffffff; }
.row { display: flex; gap: 8px; margin-bottom: 16px; }
button { display: flex; box-sizing: border-box; width: 44px; height: 44px; margin: 0; padding: 0; border: 0; border-radius: 0; }
svg { display: block; margin: auto; }
.dark { background-color: #ececf0; color: #1d1d1f; }
.light { background-color: #1d1d1f; color: #f5f5f7; }
.faint { background-color: #ececf0; color: rgba(29, 29, 31, 0.5); }
</style>

<div class="row dark-row"><button class="dark open" aria-label="Open"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M1.5 4.5v8h13v-7h-6l-1.5-1.5h-5.5z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark paste" aria-label="Paste"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3H3v11h10V3h-2M5.5 2h5v2.5h-5z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark export" aria-label="Export"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 10V2M5 5l3-3 3 3M3 9v5h10V9" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark undo" aria-label="Undo"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3L2 6l3 3M2 6h7a4 4 0 0 1 0 8H6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark redo" aria-label="Redo"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M11 3l3 3-3 3M14 6H7a4 4 0 0 0 0 8h3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark tools" aria-label="Tools"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12M5 2v4M11 6v4M7 10v4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark expand" aria-label="Expand"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark voice" aria-label="Voice"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 6v4M5 4v8M8 2v12M11 4v8M14 6v4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark mute" aria-label="Mute"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 6h3l4-3v10l-4-3H2zM11 6l3 4M14 6l-3 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="dark send" aria-label="Send"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button></div>
<div class="row light-row"><button class="light open" aria-label="Open"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M1.5 4.5v8h13v-7h-6l-1.5-1.5h-5.5z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light paste" aria-label="Paste"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3H3v11h10V3h-2M5.5 2h5v2.5h-5z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light export" aria-label="Export"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 10V2M5 5l3-3 3 3M3 9v5h10V9" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light undo" aria-label="Undo"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3L2 6l3 3M2 6h7a4 4 0 0 1 0 8H6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light redo" aria-label="Redo"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M11 3l3 3-3 3M14 6H7a4 4 0 0 0 0 8h3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light tools" aria-label="Tools"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12M5 2v4M11 6v4M7 10v4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light expand" aria-label="Expand"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light voice" aria-label="Voice"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 6v4M5 4v8M8 2v12M11 4v8M14 6v4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light mute" aria-label="Mute"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 6h3l4-3v10l-4-3H2zM11 6l3 4M14 6l-3 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="light send" aria-label="Send"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button></div>
