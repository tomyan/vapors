<style>
/* viewport 640x400 */
.outer { margin: 10px 20px; padding: 0 5px; background-color: #eee; }
.inner { margin: 15px 0; height: 20px; background-color: #c33; }
.sized { width: 50%; max-width: 150px; min-height: 30px; box-sizing: border-box; padding: 10px; background-color: #33c; }
.auto { width: 100px; margin: 0 auto; height: 10px; background-color: #3c3; }
</style>

<div class="outer"><div class="inner"></div><div class="inner"></div></div>
<div class="sized"></div>
<div class="auto"></div>
