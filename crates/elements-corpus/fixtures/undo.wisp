<style>
/* viewport 640x400 */
/* A text field for undo and paste (E6b): `name` at x 0..240 holding
   "Warm". Its font and border are set, as Chromium's field takes
   neither from the page. The look is not compared otherwise (Q1). */
body { margin: 0; display: flex; font-size: 14px; }
#name { box-sizing: border-box; width: 240px; height: 24px; margin: 0; padding: 1px 2px; border: 1px solid #555; font-family: Geist; font-size: 14px; }
</style>

<input id="name" type="text" value="Warm" />
